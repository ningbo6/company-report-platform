# 请运行 python -m library.cli init 生成随机 SESSION_SECRET，勿使用示例值直接上线。
SESSION_SECRET=
# 二维码初始前缀；管理员在后台“二维码设置”保存后，以数据库中的配置为准，无需重启。
BASE_URL=http://127.0.0.1:18888
COOKIE_SECURE=false
MAX_FILE_MB=100
QR_MODE=test
LOGO_READY=false
# 高清校徽文件建议存放于 assets/；至少 512×512，保持原始清晰度。
# LOGO_PATH=/app/assets/school-emblem.png
# 管理与公开服务都只绑定宿主机回环地址，防火墙勿开放这两个端口。
HTTP_PORT=18889
PUBLIC_HTTP_PORT=18888
# 本地 HTTP 开发使用 COOKIE_SECURE=false；服务器内网 HTTPS 管理入口使用 true。
# 公网入口不提供登录，会剥离 Cookie；BASE_URL 上线时改为正式 HTTPS 域名。
